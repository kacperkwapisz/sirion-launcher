<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sirion" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:fontFamily">@font/inter_tight_regular</item>
        <item name="android:windowAnimationStyle">@style/ScreenAnimations</item>
    </style>

    <!-- Home's cold start shows the D (see launch_background); HomeActivity swaps in plain black once drawn. -->
    <style name="Theme.Sirion.Home">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Screen changes: short fades instead of the default slide and zoom. -->
    <style name="ScreenAnimations" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_in</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/screen_in</item>
        <item name="android:taskOpenExitAnimation">@anim/screen_hold</item>
        <item name="android:taskCloseEnterAnimation">@anim/screen_hold</item>
        <item name="android:taskCloseExitAnimation">@anim/screen_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/screen_in</item>
        <item name="android:taskToFrontExitAnimation">@anim/screen_hold</item>
        <item name="android:taskToBackEnterAnimation">@anim/screen_hold</item>
        <item name="android:taskToBackExitAnimation">@anim/screen_out</item>
    </style>

    <!-- Type scale: hero 36, card 26, secondary 22, context 18, times 16. -->
    <style name="Text">
        <item name="android:fontFamily">@font/inter_tight_regular</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Text.Hero">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">36dp</item>
    </style>
    <style name="Text.CardTitle">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">26dp</item>
    </style>
    <style name="Text.Secondary">
        <item name="android:textSize">26dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Context">
        <item name="android:textSize">18dp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Small">
        <item name="android:textSize">16dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Text.Button">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">22dp</item>
    </style>

    <style name="Text.RowTitle">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">22dp</item>
    </style>
    <style name="Text.ButtonSmall">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">20dp</item>
    </style>

    <!-- Pairing code: the screen's whole job, so it's the biggest text on it. -->
    <style name="Text.Code">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">56dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Text.Step">
        <item name="android:textSize">20dp</item>
        <item name="android:maxLines">3</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="Text.StepNumber">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">16dp</item>
    </style>

    <style name="Text.KeypadDigit">
        <item name="android:textSize">36dp</item>
    </style>
    <style name="Text.KeypadLetters">
        <item name="android:textSize">16dp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">20dp</item>
    </style>
    <style name="Tap">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">@drawable/press_overlay</item>
    </style>
    <style name="PhoneAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_inner</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="PhoneActionGlyph">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
    <style name="PhoneActionLabel" parent="Text.Small">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>
    <style name="Segment" parent="Text">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- Call buttons: 76px tall. Answer green, decline/end red, both with black text. -->
    <style name="CallButton" parent="Text.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">@color/text_primary</item>
    </style>
    <style name="CallButton.Inner">
        <item name="android:background">@drawable/bg_inner</item>
    </style>
    <style name="CallButton.Danger">
        <item name="android:background">@drawable/bg_call_danger</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:drawableTint">@color/text_on_light</item>
    </style>
    <style name="CallButton.Answer">
        <item name="android:background">@drawable/bg_call_answer</item>
        <item name="android:textColor">@color/text_on_light</item>
        <item name="android:drawableTint">@color/text_on_light</item>
    </style>
    <style name="Slider">
        <item name="android:layout_height">64dp</item>
        <item name="android:progressDrawable">@drawable/slider_track</item>
        <item name="android:thumb">@drawable/slider_thumb</item>
        <item name="android:splitTrack">false</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:background">@null</item>
    </style>
    <style name="PopoverTitle" parent="Text">
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">22dp</item>
    </style>
    <style name="TuneButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_inner</item>
        <item name="android:padding">23dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
    <style name="TransportButton">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:background">@drawable/bg_bar_button</item>
        <item name="android:padding">22dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text_primary</item>
    </style>
    <!-- Shuffle and repeat: 28px glyph in a 76px target. -->
    <style name="TransportButton.Small">
        <item name="android:padding">24dp</item>
    </style>
    <style name="SourceRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">76dp</item>
        <item name="android:background">@drawable/bg_source_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
    <style name="SourceText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="SourceName" parent="Text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/inter_tight_medium</item>
        <item name="android:textSize">22dp</item>
    </style>
</resources>
