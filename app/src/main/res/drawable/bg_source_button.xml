<!-- Source button: white 10% over the card; filled #262626 while its picker is open (selected). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><shape><solid android:color="@color/surface_inner" /><corners android:radius="10dp" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="#33FFFFFF" /><corners android:radius="10dp" /></shape></item>
    <item><shape><solid android:color="#1AFFFFFF" /><corners android:radius="10dp" /></shape></item>
</selector>
