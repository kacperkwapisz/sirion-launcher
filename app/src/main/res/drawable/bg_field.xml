<!-- Text field: black, accent outline while typing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/background" /><stroke android:width="1dp" android:color="@color/accent" /><corners android:radius="10dp" /></shape></item>
    <item><shape><solid android:color="@color/background" /><stroke android:width="1dp" android:color="@color/surface_track" /><corners android:radius="10dp" /></shape></item>
</selector>
