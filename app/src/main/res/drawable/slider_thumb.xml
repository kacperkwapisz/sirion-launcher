<!--
    Slider knob: 32px white circle; dragging adds a 6px accent ring so the
    finger never hides it. Both states are 44 × 44, so the knob stays round:
    a selector whose states differ in size gets laid out with one state's
    width and the other's height (the "egg").
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:constantSize="true">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/text_primary" />
            <stroke android:width="6dp" android:color="#59E8663D" />
            <size android:width="44dp" android:height="44dp" />
        </shape>
    </item>
    <item>
        <inset android:inset="6dp">
            <shape android:shape="oval">
                <solid android:color="@color/text_primary" />
                <size android:width="32dp" android:height="32dp" />
            </shape>
        </inset>
    </item>
</selector>
