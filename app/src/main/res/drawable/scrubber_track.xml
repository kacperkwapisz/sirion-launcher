<!-- Music scrubber: 8px track, white 20% (it may sit on dimmed artwork), accent fill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="8dp"><shape><solid android:color="#33FFFFFF" /><corners android:radius="4dp" /></shape></item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="8dp"><clip><shape><solid android:color="@color/accent" /><corners android:radius="4dp" /></shape></clip></item>
</layer-list>
