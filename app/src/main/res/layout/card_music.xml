<?xml version="1.0" encoding="utf-8"?>
<!-- Music card (hero): what's playing and how to control it. No context label. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/music_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.55"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <View
        android:id="@+id/music_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_music"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:id="@+id/music_mark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_mark"
            android:backgroundTint="@color/mark_bluetooth">

            <ImageView
                android:id="@+id/music_mark_glyph"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/brand_bluetooth" />
        </FrameLayout>

        <TextView
            android:id="@+id/music_title"
            style="@style/Text.Hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="148dp" />

        <TextView
            android:id="@+id/music_line"
            style="@style/Text.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="148dp"
            android:textColor="@color/text_on_artwork" />

        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/music_progress_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/music_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:max="1000"
                android:progressDrawable="@drawable/scrubber" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/music_elapsed"
                    style="@style/Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_on_artwork" />

                <TextView
                    android:id="@+id/music_remaining"
                    style="@style/Text.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:textColor="@color/text_on_artwork" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/music_transport"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginHorizontal="-12dp">

            <ImageButton
                android:id="@+id/music_prev"
                style="@style/TransportButton"
                android:contentDescription="Previous"
                android:src="@drawable/g_prev" />

            <ImageButton
                android:id="@+id/music_play_pause"
                style="@style/TransportButton"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Play or pause"
                android:src="@drawable/g_pause" />

            <ImageButton
                android:id="@+id/music_next"
                style="@style/TransportButton"
                android:layout_gravity="end"
                android:contentDescription="Next"
                android:src="@drawable/g_next" />
        </FrameLayout>

        <TextView
            android:id="@+id/music_action"
            style="@style/Text.Button"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:drawablePadding="10dp"
            android:drawableTint="@color/text_on_light"
            android:paddingHorizontal="24dp"
            android:textColor="@color/text_on_light"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/music_artwork"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_gravity="top|end"
        android:layout_margin="20dp"
        android:clipToOutline="true"
        android:background="@drawable/artwork_placeholder"
        android:scaleType="centerCrop" />
</FrameLayout>
