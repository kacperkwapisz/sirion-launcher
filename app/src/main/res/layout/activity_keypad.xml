<?xml version="1.0" encoding="utf-8"?>
<!-- Phone · Keypad (Paper: "Phone and calls"). Number and Call left, keys right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <include layout="@layout/status_strip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <LinearLayout
            style="@style/Card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_mark" android:backgroundTint="@color/mark_phone">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/g_phone" android:tint="@color/text_on_light" />
                </FrameLayout>
                <TextView android:id="@+id/keypad_context" style="@style/Text.Context" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" />
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView
                    android:id="@+id/keypad_number"
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="start"
                    android:fontFamily="@font/inter_tight_medium"
                    android:fontFeatureSettings="tnum"
                    android:letterSpacing="0.01"
                    android:textSize="44dp" />
                <ImageButton
                    android:id="@+id/keypad_backspace"
                    android:layout_width="76dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_bar_button"
                    android:contentDescription="Delete"
                    android:src="@drawable/g_backspace"
                    android:tint="@color/text_secondary" />
            </LinearLayout>

            <TextView android:id="@+id/keypad_line" style="@style/Text.Context" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" />

            <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/keypad_call"
                style="@style/CallButton.Answer"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_weight="0"
                android:drawableStart="@drawable/g_phone_28"
                android:text="@string/call" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keypad_keys"
            android:layout_width="520dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp" />
    </LinearLayout>

    <include layout="@layout/bottom_bar" />
</LinearLayout>
