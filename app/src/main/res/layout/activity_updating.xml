<?xml version="1.0" encoding="utf-8"?>
<!-- Updating: the startup look (D, thin bar) plus one line saying what's happening. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="208dp"
            android:layout_height="80dp"
            android:src="@drawable/daihatsu_mark" />

        <FrameLayout
            android:id="@+id/updating_track"
            android:layout_width="160dp"
            android:layout_height="4dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/updating_track">

            <View
                android:id="@+id/updating_fill"
                android:layout_width="62dp"
                android:layout_height="4dp"
                android:background="@drawable/updating_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/updating_line"
            style="@style/Text.Context"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginTop="24dp"
            android:gravity="center" />
    </LinearLayout>
</FrameLayout>
