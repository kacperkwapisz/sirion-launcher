<?xml version="1.0" encoding="utf-8"?>
<!-- Music · Source picker card: where music comes from. Shown through Popover, below its trigger. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="440dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popover"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
        <TextView style="@style/PopoverTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Play from" />
        <TextView android:id="@+id/source_count" style="@style/Text.Context" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout android:id="@+id/source_bluetooth" style="@style/SourceRow">
        <FrameLayout android:id="@+id/source_bluetooth_mark" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_mark" android:backgroundTint="@color/mark_bluetooth">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/brand_bluetooth" />
        </FrameLayout>
        <LinearLayout style="@style/SourceText">
            <TextView android:id="@+id/source_bluetooth_name" style="@style/SourceName" android:text="Bluetooth" />
            <TextView android:id="@+id/source_bluetooth_line" style="@style/Text.Context" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageView android:id="@+id/source_bluetooth_check" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/g_check" android:tint="@color/accent" />
    </LinearLayout>

    <LinearLayout android:id="@+id/source_radio" style="@style/SourceRow">
        <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_mark" android:backgroundTint="@color/mark_radio">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/g_radio" android:tint="@color/text_on_light" />
        </FrameLayout>
        <LinearLayout style="@style/SourceText">
            <TextView style="@style/SourceName" android:text="Radio" />
            <TextView android:id="@+id/source_radio_line" style="@style/Text.Context" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageView android:id="@+id/source_radio_check" android:layout_width="26dp" android:layout_height="26dp" android:src="@drawable/g_check" android:tint="@color/accent" />
    </LinearLayout>

    <LinearLayout android:id="@+id/source_carplay" style="@style/SourceRow">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/brand_carplay" />
        <LinearLayout style="@style/SourceText">
            <TextView style="@style/SourceName" android:text="CarPlay" />
            <TextView style="@style/Text.Context" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Opens CarPlay full screen" />
        </LinearLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/g_chevron" android:tint="@color/text_secondary" />
    </LinearLayout>

    <LinearLayout android:id="@+id/source_usb" style="@style/SourceRow">
        <FrameLayout android:id="@+id/source_usb_mark" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_mark" android:backgroundTint="@color/mark_neutral">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_gravity="center" android:src="@drawable/g_usb" android:tint="@color/text_primary" />
        </FrameLayout>
        <LinearLayout style="@style/SourceText">
            <TextView android:id="@+id/source_usb_name" style="@style/SourceName" android:text="USB" />
            <TextView android:id="@+id/source_usb_line" style="@style/Text.Context" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/g_chevron" android:tint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
