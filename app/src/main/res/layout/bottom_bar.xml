<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom bar: navigation left, volume in the centre (most used), brightness right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:paddingHorizontal="12dp">

    <LinearLayout
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/nav_home"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_bar_button"
            android:contentDescription="Home"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/g_home_filled"
            android:tint="@color/accent" />

        <ImageButton
            android:id="@+id/nav_apps"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_bar_button"
            android:contentDescription="Apps"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/g_apps"
            android:tint="@color/text_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/volume_down"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_bar_button"
            android:contentDescription="Volume down"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/g_minus"
            android:tint="@color/accent" />

        <LinearLayout
            android:id="@+id/volume_value_area"
            android:layout_width="96dp"
            android:layout_height="76dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_bar_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/volume_glyph"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/g_speaker"
                android:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/volume_value"
                style="@style/Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/inter_tight_medium"
                android:fontFeatureSettings="tnum"
                android:textSize="34dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/volume_up"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_bar_button"
            android:contentDescription="Volume up"
            android:padding="22dp"
            android:scaleType="fitCenter"
            android:src="@drawable/g_plus"
            android:tint="@color/accent" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/brightness"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/bg_bar_button"
        android:contentDescription="Brightness"
        android:padding="23dp"
        android:scaleType="fitCenter"
        android:src="@drawable/g_sun"
        android:tint="@color/text_primary" />
</FrameLayout>
