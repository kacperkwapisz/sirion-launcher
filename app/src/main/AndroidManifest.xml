<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Sunrise and sunset for the brightness popover. Granted by the install script. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SirionApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Sirion">

        <activity
            android:name=".ui.HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Sirion.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.UpdatingActivity"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />

        <!-- Starts the process at boot so Bluetooth is fixed before anyone opens the launcher. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="autochips.intent.action.QB_POWERON" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".ui.AppsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.CallActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <activity
            android:name=".ui.PhoneActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.RadioActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.MusicActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustPan|stateHidden" />

        <activity
            android:name=".ui.UnitAppsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.AllAppsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.KeypadActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|fontScale"
            android:screenOrientation="landscape" />

        <!-- Lets us read DiPlay's CarPlay song (see SessionAccess); allowed by the root helper. -->
        <service
            android:name=".data.SessionAccess"
            android:exported="false"
            android:label="Sirion CarPlay music"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Our volume card over any app when the volume changes (see VolumePopup). -->
        <service
            android:name=".ui.VolumePopup"
            android:exported="false"
            android:label="Sirion volume card"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/volume_popup" />
        </service>
    </application>
</manifest>
